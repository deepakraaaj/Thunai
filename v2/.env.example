# Anchor — v2 environment (ALL keys are server-side; never exposed to client
# except the two NEXT_PUBLIC_ Supabase values, which are the public anon pair).

# --- AI providers (server-only) ---
# Cerebras primary — OpenAI-compatible chat completions
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Optional pin; if unset, the app fetches /models and picks the fastest Llama-class
CEREBRAS_MODEL=

# Gemini failover — Flash-Lite family
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Sarvam TTS (server-only). If absent, the voice ladder skips Sarvam and uses
# the browser speechSynthesis tier — nothing breaks.
SARVAM_API_KEY=

# --- Supabase (events table + realtime). The anon pair is public by design. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
